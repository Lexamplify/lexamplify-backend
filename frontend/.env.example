# Example frontend settings. Copy what you need into your own .env file; this file holds no real values and no secrets.

# The executive assistant page (#/assistant).
#   on (default, or unset) - the Today ask bar hands your command to the assistant, which decides whether it is a
#                            question, a draft or a page to open.
#   false                  - the Today ask bar behaves exactly as it did before: it opens Auto-Draft with your text.
VITE_ASSISTANT_PAGE=true

# Where the backend is. Leave unset in local development: Vite proxies /api to the Flask server.
# VITE_API_BASE_URL=
