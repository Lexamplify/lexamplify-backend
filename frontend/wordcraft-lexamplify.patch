diff --git a/apps/wordcraft-web/src/bridge.rs b/apps/wordcraft-web/src/bridge.rs
new file mode 100644
index 0000000..9816731
--- /dev/null
+++ b/apps/wordcraft-web/src/bridge.rs
@@ -0,0 +1,208 @@
+//! JS ⇄ WordCraft bridge.
+//!
+//! Lets the host page drive the running editor without touching egui input events:
+//!  - `wc_load(name, base64)`      — open a document (HTML / Markdown / text / .docx bytes)
+//!  - `wc_exec(id, params_json)`   — run any engine command (the same vocabulary the agent/MCP
+//!                                   surface uses: `text.insert`, `edit.replaceAll`, `select.text`,
+//!                                   `document.setText`, ribbon formatting, …)
+//!  - `wc_text()` / `wc_html()`    — read the current document out (for autosave / export)
+//!  - `wc_rev()` / `wc_doc_id()`   — change counter + which document is open (autosave triggers)
+//!  - `wc_request_bytes(ext)` + `wc_take_bytes(ext)` — export the document to bytes (docx/pdf/…)
+//!
+//! Commands are queued and applied on the next frame by [`crate::web::WebShell`] through
+//! `WordApp::execute` (the "never asks first" agent path). There is no realtime collaboration;
+//! the host layers sharing/roles/presence and persistence on top of these primitives.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use serde_json::{json, Value};
+use wasm_bindgen::prelude::*;
+
+#[derive(Default)]
+pub struct BridgeState {
+    pub ctx: Option<egui::Context>,
+    pub commands: Vec<(String, Value)>,
+    pub bytes_req: Vec<String>,
+    pub bytes_out: HashMap<String, Vec<u8>>,
+    pub text: String,
+    pub html: String,
+    pub selection: String,
+    pub rev: u64,
+    pub doc_id: u64,
+    pub ready: bool,
+}
+
+pub type Bridge = Rc<RefCell<BridgeState>>;
+
+thread_local! {
+    static BRIDGE: RefCell<Option<Bridge>> = const { RefCell::new(None) };
+}
+
+/// Create the shared bridge and register it for the JS exports. Called once from `web::start`.
+pub fn install() -> Bridge {
+    let b: Bridge = Rc::new(RefCell::new(BridgeState::default()));
+    BRIDGE.with(|slot| *slot.borrow_mut() = Some(b.clone()));
+    b
+}
+
+fn read<T>(default: T, f: impl FnOnce(&BridgeState) -> T) -> T {
+    BRIDGE.with(|slot| match slot.borrow().as_ref() {
+        Some(b) => f(&b.borrow()),
+        None => default,
+    })
+}
+
+fn write(f: impl FnOnce(&mut BridgeState)) {
+    BRIDGE.with(|slot| {
+        if let Some(b) = slot.borrow().as_ref() {
+            f(&mut b.borrow_mut());
+        }
+    });
+}
+
+fn repaint() {
+    BRIDGE.with(|slot| {
+        if let Some(b) = slot.borrow().as_ref()
+            && let Some(ctx) = b.borrow().ctx.clone()
+        {
+            ctx.request_repaint();
+        }
+    });
+}
+
+/// True once the editor has mounted and mirrored its first document.
+#[wasm_bindgen]
+pub fn wc_ready() -> bool {
+    read(false, |s| s.ready)
+}
+
+/// Open a document from bytes. `name` only names the format (by extension); `base64` is the data.
+#[wasm_bindgen]
+pub fn wc_load(name: String, base64: String) {
+    write(|s| s.commands.push(("file.open".into(), json!({ "path": name, "data": base64 }))));
+    repaint();
+}
+
+/// Run an engine command. `params_json` is a JSON object (or empty/`null` for none).
+#[wasm_bindgen]
+pub fn wc_exec(id: String, params_json: String) {
+    let params: Value = serde_json::from_str(&params_json).unwrap_or(Value::Null);
+    write(|s| s.commands.push((id, params)));
+    repaint();
+}
+
+/// The current document body as plain text.
+#[wasm_bindgen]
+pub fn wc_text() -> String {
+    read(String::new(), |s| s.text.clone())
+}
+
+/// The current document as HTML.
+#[wasm_bindgen]
+pub fn wc_html() -> String {
+    read(String::new(), |s| s.html.clone())
+}
+
+/// The currently selected text (empty when nothing is selected). Lets the host run a
+/// selection-scoped AI edit and write the result back.
+#[wasm_bindgen]
+pub fn wc_selection() -> String {
+    read(String::new(), |s| s.selection.clone())
+}
+
+/// Revision counter — bumped by every change. Host polls this to know when to autosave.
+#[wasm_bindgen]
+pub fn wc_rev() -> f64 {
+    read(0.0, |s| s.rev as f64)
+}
+
+/// Which document is open — changes when a new document replaces the current one.
+#[wasm_bindgen]
+pub fn wc_doc_id() -> f64 {
+    read(0.0, |s| s.doc_id as f64)
+}
+
+/// Ask the editor to serialise the document to `ext` (docx, pdf, html, md, txt, …).
+/// The bytes are produced next frame; collect them with [`wc_take_bytes`].
+#[wasm_bindgen]
+pub fn wc_request_bytes(ext: String) {
+    write(|s| s.bytes_req.push(ext));
+    repaint();
+}
+
+/// Collect bytes produced by [`wc_request_bytes`]. Empty until they are ready (poll).
+#[wasm_bindgen]
+pub fn wc_take_bytes(ext: String) -> Vec<u8> {
+    let mut out = Vec::new();
+    write(|s| {
+        if let Some(bytes) = s.bytes_out.remove(&ext) {
+            out = bytes;
+        }
+    });
+    out
+}
+
+/// Apply everything the host queued and mirror the document out. Called once per frame by the shell.
+pub fn pump(bridge: &Bridge, app: &mut wordcraft_ui_egui::WordApp) {
+    // 1) run queued commands (carry-in, AI edits, formatting, …)
+    let commands = std::mem::take(&mut bridge.borrow_mut().commands);
+    for (id, params) in commands {
+        if let Err(e) = app.execute(&id, params) {
+            log::warn!("wc_exec '{id}' failed: {e}");
+        }
+    }
+
+    // 2) serve export-bytes requests
+    let reqs = std::mem::take(&mut bridge.borrow_mut().bytes_req);
+    for ext in reqs {
+        let name = format!("document.{ext}");
+        match wordcraft_engine::io::save_bytes(&name, &app.session.doc) {
+            Ok(bytes) => {
+                bridge.borrow_mut().bytes_out.insert(ext, bytes);
+            }
+            Err(e) => log::warn!("export .{ext} failed: {e}"),
+        }
+    }
+
+    // 3) mirror the document out when it has changed (cheap revision check)
+    let rev = app.session.rev();
+    let doc_id = app.session.document_id();
+    let (last_rev, last_id, ready) = {
+        let s = bridge.borrow();
+        (s.rev, s.doc_id, s.ready)
+    };
+    if rev != last_rev || doc_id != last_id || !ready {
+        // Pure serialisation — never mutates the document (so it can't bump `rev`).
+        let serialise = |ext: &str| {
+            wordcraft_engine::io::save_bytes(&format!("document.{ext}"), &app.session.doc)
+                .ok()
+                .map(|b| String::from_utf8_lossy(&b).into_owned())
+                .unwrap_or_default()
+        };
+        let text = serialise("txt");
+        let html = serialise("html");
+        let mut s = bridge.borrow_mut();
+        s.text = text;
+        s.html = html;
+        s.rev = rev;
+        s.doc_id = doc_id;
+        s.ready = true;
+    }
+
+    // Mirror the current selection every frame (it changes on caret move, independent of `rev`).
+    let sel = app.session.selected_text();
+    {
+        let mut s = bridge.borrow_mut();
+        if s.selection != sel {
+            s.selection = sel;
+        }
+    }
+
+    // Heartbeat: keep a gentle repaint pending so queued host commands are always applied
+    // promptly, even when the user isn't interacting (an idle egui app stops running frames).
+    if let Some(ctx) = bridge.borrow().ctx.clone() {
+        ctx.request_repaint_after(std::time::Duration::from_millis(200));
+    }
+}
