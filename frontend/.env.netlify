# Build env for the Netlify test environment (vite build --mode netlify).
# Firebase/production builds use .env.production instead and are unaffected.
# Empty API base => the app calls a RELATIVE /api, which the Netlify _redirects
# proxy forwards same-origin to api.lexamplify.com (which does NOT CORS-allow
# netlify.app origins, so an absolute base would be blocked).
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=213873431218-m2enic38tjthanhdrbb2lrlpuvp6lihf.apps.googleusercontent.com
