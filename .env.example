# Core (existing)
DATABASE_URL=sqlite:///database.db
FLASK_ENV=development
FLASK_DEBUG=true
GROQ_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=
TAVILY_API_KEY=
ZENROWS_API_KEY=
JWT_SECRET_KEY=change-me-to-a-long-random-value
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=static/uploads

# ── Workspace refactor (phased rollout) ─────────────────────────
# WORKSPACES_ENABLED: master switch for the workspaces feature.
#   false = every code path behaves exactly like before (default).
#   true  = workspace endpoints + X-Workspace-Id scoping are active.
# WORKSPACE_ISOLATION_MODE: how strictly the workspace decorator enforces scoping.
#   observe = log cross-workspace reads without blocking (rollout phase).
#   enforce = hard-block cross-workspace access (post-rollout).
WORKSPACES_ENABLED=true
WORKSPACE_ISOLATION_MODE=observe
MODEL_NAME=
SOURCE_TYPE=
PORT=5000

# No local Redis/Celery worker? Set to true to run Deep Scan/library tasks
# synchronously in-process instead of dispatching to a broker (see
# celery_app.py). Leave unset/false in any deployed environment.
CELERY_TASK_ALWAYS_EAGER=false

# Auth cookies
# JWT_COOKIE_SECURE: true in production (HTTPS). Auto-defaults from FLASK_ENV if unset.
JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAMESITE: "Strict" requires frontend+backend on the same registrable
# domain. This repo's current split-origin deploy (frontend on Vite/Vercel,
# backend on Render) needs "None" here (with JWT_COOKIE_SECURE=true) instead.
JWT_COOKIE_SAMESITE=Strict

# Password reset email (SMTP) — unset means reset links are logged, not sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@lexamplify.in

# Gates GET /api/admin/sync-court-data (?token=...) — a manual roster/VC/
# leave sync trigger meant to be opened directly in a browser on a shell-less
# deploy. Unset means the route refuses every request (fails closed).
ADMIN_SYNC_TOKEN=

# Enterprise SSO (Authlib) — unset provider's routes respond 503, app still boots
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where to land the browser after a successful SSO login
SSO_FRONTEND_REDIRECT=http://localhost:5173/dashboard

# Voice typing (speech-to-text). Uses GROQ_API_KEY (already used for the AI). All of these are optional.
# STT_MODEL=whisper-large-v3
# STT_FALLBACK_MODEL=whisper-large-v3-turbo
# STT_RATE_LIMIT=40 per minute
# STT_MAX_BYTES=12582912
# STT_PARSE_MODEL=groq/llama-3.3-70b-versatile

# Assistant answer engine (optional; defaults to ON; set false/0/no/off to turn the answer engine off)
# ASSISTANT_ANSWERS_ENABLED=true
# Comma lists of models; only gpt-oss-120b, gpt-oss-20b, qwen3.8-27b are accepted:
# ASSISTANT_ANSWER_MODELS=gpt-oss-120b,gpt-oss-20b
# ASSISTANT_GENERAL_MODELS=gpt-oss-20b,gpt-oss-120b
# Tokens per minute per model for the assistant (each model has its own 8K limit):
# ASSISTANT_PACER_TPM=5000

# Assistant "create a matter" guided write (Phase 1a). OFF by default: only "true/1/yes/on" (any case)
# enables it; a missing/empty value, or "false/0/no/off", keeps the write path off.
# ASSISTANT_CREATE_MATTER_ENABLED=false
