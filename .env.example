# Core (existing)
DATABASE_URL=sqlite:///database.db
FLASK_ENV=development
FLASK_DEBUG=true
GROQ_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=
TAVILY_API_KEY=
ZENROWS_API_KEY=
JWT_SECRET_KEY=change-me-to-a-long-random-value
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=static/uploads
MODEL_NAME=
SOURCE_TYPE=
PORT=5000

# No local Redis/Celery worker? Set to true to run Deep Scan/library tasks
# synchronously in-process instead of dispatching to a broker (see
# celery_app.py). Leave unset/false in any deployed environment.
CELERY_TASK_ALWAYS_EAGER=false

# Auth cookies
# JWT_COOKIE_SECURE: true in production (HTTPS). Auto-defaults from FLASK_ENV if unset.
JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAMESITE: "Strict" requires frontend+backend on the same registrable
# domain. This repo's current split-origin deploy (frontend on Vite/Vercel,
# backend on Render) needs "None" here (with JWT_COOKIE_SECURE=true) instead.
JWT_COOKIE_SAMESITE=Strict

# Password reset email (SMTP) — unset means reset links are logged, not sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@lexamplify.in

# Enterprise SSO (Authlib) — unset provider's routes respond 503, app still boots
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where to land the browser after a successful SSO login
SSO_FRONTEND_REDIRECT=http://localhost:5173/dashboard
