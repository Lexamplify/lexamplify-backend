# /etc/lexamplify/backend.env  — fill with REAL values (never commit the real file).
# Your provided env overrides this template.

# --- Database (Supabase session pooler; KEEP :5432 session pooler, not :6543) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- Auth / secrets (use strong values; rotate the ones exposed in chat) ---
JWT_SECRET_KEY=<strong-random-secret>

# --- AI providers (app degrades, not crashes, if missing) ---
OPENAI_API_KEY=<key>
GROQ_API_KEY=<key>

# --- Workspace isolation / RLS plumbing ---
WORKSPACES_ENABLED=true
WORKSPACE_ISOLATION_MODE=enforce
# Central X-Workspace-Id authz gate: 'observe' (log only, safe) | 'enforce' (403 cross-firm) | 'off'
WORKSPACE_HEADER_AUTHZ=observe
# Session GUCs for future RLS cutover (inert until app connects as app_rls)
DB_SESSION_GUC=on
LEGACY_SQLITE_SHIM=on

# --- Email / SMTP (team-invite + notification emails). UNSET = no email is
#     sent (the mailer just logs "would send"); team invites still work via
#     claim-on-login. Set all four SMTP_* to turn real sending on, then restart. ---
# SMTP_HOST=smtp.sendgrid.net        # or email-smtp.<region>.amazonaws.com (SES), smtp.gmail.com, ...
# SMTP_PORT=587
# SMTP_USER=<smtp-username>          # SendGrid: literally "apikey"; SES: the SMTP username
# SMTP_PASSWORD=<smtp-password>      # SendGrid: the API key; SES: the SMTP password; Gmail: an app password
# MAIL_FROM=no-reply@lexamplify.in   # a verified sender for your provider
# APP_PUBLIC_URL=https://app.lexamplify.com   # used for the sign-in link in invite emails

# --- Optional integrations (only if used) ---
# REDIS_URL=redis://127.0.0.1:6379/0
# PINECONE_API_KEY=<key>
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<key>
# EMAIL_DRY_RUN=true

# ============================================================================
# SCALE HARDENING (all optional; unset = original single-process behaviour)
# See deploy/aws/SCALE_READINESS.md for the full plan and honest ceilings.
# ============================================================================

# --- Shared cache / cross-process state (reuses the Celery Redis) ---
# Set REDIS_URL to switch rate limiting, revocation and app caches from
# per-process memory to ONE store shared by every worker and box. Required
# before running more than one worker/instance meaningfully.
# REDIS_URL=redis://127.0.0.1:6379/0
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1   # defaults to REDIS_URL if unset

# Hot-path JWT revocation cache: answers "not revoked" from Redis so every
# authenticated request skips a DB round-trip. Needs REDIS_URL. Default: off.
# REVOCATION_CACHE=on

# --- DB connection budget (per process). Set in step with the session-pooler
#     cap and worker/instance count. Defaults preserve the original (1, 16). ---
# PG_POOL_MIN=1
# PG_POOL_MAX=16

# --- Gunicorn tuning (optional) ---
# WEB_CONCURRENCY=2          # processes; ~2×vCPU once heavy work is on Celery
# GUNICORN_THREADS=6
# GUNICORN_TIMEOUT=120
