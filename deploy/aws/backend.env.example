# /etc/lexamplify/backend.env  — fill with REAL values (never commit the real file).
# Your provided env overrides this template.

# --- Database (Supabase session pooler; KEEP :5432 session pooler, not :6543) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- Auth / secrets (use strong values; rotate the ones exposed in chat) ---
JWT_SECRET_KEY=<strong-random-secret>

# --- AI providers (app degrades, not crashes, if missing) ---
OPENAI_API_KEY=<key>
GROQ_API_KEY=<key>

# --- Workspace isolation / RLS plumbing ---
WORKSPACES_ENABLED=true
WORKSPACE_ISOLATION_MODE=enforce
# Central X-Workspace-Id authz gate: 'observe' (log only, safe) | 'enforce' (403 cross-firm) | 'off'
WORKSPACE_HEADER_AUTHZ=observe
# Session GUCs for future RLS cutover (inert until app connects as app_rls)
DB_SESSION_GUC=on
LEGACY_SQLITE_SHIM=on

# --- Optional integrations (only if used) ---
# REDIS_URL=redis://127.0.0.1:6379/0
# PINECONE_API_KEY=<key>
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<key>
# EMAIL_DRY_RUN=true

# --- Gunicorn tuning (optional) ---
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=6
# GUNICORN_TIMEOUT=120
