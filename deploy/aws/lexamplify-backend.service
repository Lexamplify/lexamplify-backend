# /etc/systemd/system/lexamplify-backend.service
# gunicorn (gthread) behind Caddy. Reads env from /etc/lexamplify/backend.env.
#   sudo systemctl daemon-reload && sudo systemctl enable --now lexamplify-backend
#   sudo systemctl status lexamplify-backend
#   journalctl -u lexamplify-backend -f    # logs
[Unit]
Description=LexAmplify backend (gunicorn)
After=network.target

[Service]
Type=simple
# Adjust User to the box's deploy user (ubuntu on Ubuntu AMIs, ec2-user on AL).
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lexamplify
EnvironmentFile=/etc/lexamplify/backend.env
# bind on loopback only; Caddy terminates TLS and proxies in.
ExecStart=/opt/lexamplify/venv/bin/gunicorn -c gunicorn.conf.py -b 127.0.0.1:8000 "app:create_app()"
Restart=always
RestartSec=5
# give boot-time DB migrations room; gthread keepalive handles slow requests.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
